# CodeIdiomMine 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# HuggingFace 配置
HF_HOME=/path/to/huggingface/cache
HF_TOKEN=your_huggingface_token_here

# 模型配置
EMBEDDING_MODEL=codellama/CodeLlama-7b-hf
# 备选模型:
# EMBEDDING_MODEL=microsoft/codebert-base
# EMBEDDING_MODEL=microsoft/unixcoder-base

# 设备配置
DEVICE=auto
# 可选值: auto, cuda, cpu

# 数据路径配置
REPO_PATH=./repo
OUTPUT_PATH=./output

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/codeidiommine.log

# 聚类配置
DBSCAN_EPS=0.5
DBSCAN_MIN_SAMPLES=2
OPTIMIZE_CLUSTERING_PARAMS=false

